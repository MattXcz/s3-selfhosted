# --- Přihlašovací údaje k úložišti (vygeneruj náhodné, nikam nesdílej) ---
# např.: openssl rand -hex 16
S3_BUCKET=my-bucket
S3_ACCESS_KEY=zmen-mne-nahodny-access-key
S3_SECRET_KEY=zmen-mne-nahodny-secret-key-min-20-znaku

# --- Volitelné ---
S3_REGION=us-east-1
# Povolené CORS originy (čárkou oddělené), pro produkci omez na svoje domény
S3_CORS_ORIGINS=*
# Max. velikost jednoho nahrávaného souboru
S3_MAX_FILE_SIZE=100MB
# Vše pod touto cestou v bucketu je veřejně čitelné bez přihlášení (GET/HEAD)
# prázdná hodnota = veřejný přístup úplně vypnutý
S3_PUBLIC_PREFIX=public/
# Cache-Control max-age (v sekundách) pro veřejné soubory
S3_PUBLIC_CACHE_MAX_AGE=31536000
